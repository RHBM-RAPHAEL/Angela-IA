# Chave opcional da Groq: https://console.groq.com/keys
# NÃO compartilhe nem publique seu arquivo .env no GitHub.
GROQ_API_KEY=
# O modelo llama-3.3-70b-versatile foi desativado para contas gratuitas em 2026.
GROQ_MODEL=openai/gpt-oss-20b

# Cidade padrão opcional para a previsão do tempo (sem GPS/IP).
ANGELA_WEATHER_CITY=

# Diagnóstico opcional de latência em log local, sem enviar dados externos.
ANGELA_PERF_DIAGNOSTICS=0
# Voz Thalita por segmentos. Defina 0 para voltar à síntese completa.
ANGELA_TTS_STREAMING=1
